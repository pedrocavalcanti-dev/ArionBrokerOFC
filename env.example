# ── SEGURANÇA ─────────────────────────────────────────────────
SECRET_KEY=
DEBUG=False

# ── HOSTS ─────────────────────────────────────────────────────
# Dev: manter ['*']
# Prod: trocar por seus domínios oficiais
ALLOWED_HOSTS=

# ── PROTEÇÃO CSRF (CLOUDFLARE HTTPS) ──────────────────────────
# Obrigatório no Django 4+ para o login funcionar atrás do proxy da Cloudflare
CSRF_TRUSTED_ORIGINS=

# ── BANCO DE DADOS ────────────────────────────────────────────
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ── E-MAIL ─────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_DESTINO_PADRAO=

# ── SCRAPER (Portal Claro) ────────────────────────────────────
SCRAPER_USUARIO=
SCRAPER_SENHA=

# ── OTRS (Portal Arion) ────────────────────────────────────────
OTRS_USUARIO=
OTRS_SENHA=

# ── Ligar e Desligar Robô ───────────────────────────────────────
RODA_AUTOMACAO=False
